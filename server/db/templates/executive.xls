      <Cell ss:StyleID="DataRowNumber"><Data ss:Type="Number">4950</Data></Cell>
      <Cell ss:StyleID="DataRowNumber"><Data ss:Type="Number">37950</Data></Cell>
    </Row>
<Row ss:Height="22">
      <Cell ss:StyleID="DataRowAltCenter"><Data ss:Type="Number">2</Data></Cell>
      <Cell ss:StyleID="DataRowAltCenter"><Data ss:Type="String">ADV-PKG-02</Data></Cell>
      <Cell ss:StyleID="DataRowAlt"><Data ss:Type="String">تقييم مالي وفحص نافي للجهالة لصفقة الاستحواذ</Data></Cell>
      <Cell ss:StyleID="DataRowAltCenter"><Data ss:Type="String">تقرير</Data></Cell>
