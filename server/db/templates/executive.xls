    <Cell ss:Index="3" ss:StyleID="CardValue"><Data ss:Type="String">البنك السعودي البريطاني (SAB)  |  IBAN: SA1240000009988776655443</Data></Cell>
    <Cell ss:Index="7" ss:StyleID="CardLabel"><Data ss:Type="String">إجمالي الخصم:</Data></Cell>
