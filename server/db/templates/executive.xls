   </Row>
   <Row ss:Height="20">
    <Cell ss:StyleID="DataRowAlt"><Data ss:Type="String">اسم العميل</Data></Cell>
    <Cell ss:StyleID="DataRowAlt"><Data ss:Type="String">اسم العميل أو المؤسسة المشترية</Data></Cell>
