    <Cell ss:Index="9" ss:StyleID="DataRowNumber"><Data ss:Type="Number">50.00</Data></Cell>
   </Row>
   <Row ss:Height="22">
    <Cell ss:Index="2" ss:StyleID="CardLabel"><Data ss:Type="String">الملاحظات والشروط:</Data></Cell>
