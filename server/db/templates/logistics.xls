      <Cell ss:StyleID="DataRowNumber"><Data ss:Type="Number">805</Data></Cell>
    </Row>
   <Row ss:Height="12"/>
   <Row ss:Height="22">
    <Cell ss:Index="2" ss:StyleID="CardLabel"><Data ss:Type="String">المبلغ كتابةً:</Data></Cell>
    <Cell ss:Index="3" ss:StyleID="CardValue"><Data ss:Type="String">فقط عشرة آلاف وستمائة وثلاثة وتسعون ريالاً وسبعون هللة لا غير</Data></Cell>
