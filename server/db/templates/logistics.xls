    <Cell ss:StyleID="Header"><Data ss:Type="String">المبلغ قبل الضريبة</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">الضريبة (15%)</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">المجموع شامل الضريبة</Data></Cell>
   </Row>
   <Row ss:Height="22">
      <Cell ss:StyleID="DataRowCenter"><Data ss:Type="Number">1</Data></Cell>
      <Cell ss:StyleID="DataRowCenter"><Data ss:Type="String">LOG-FRT-01</Data></Cell>
      <Cell ss:StyleID="DataRow"><Data ss:Type="String">نقل شاحنة مبردة كاملة تريلا FTL مسار الدمام - الرياض</Data></Cell>
