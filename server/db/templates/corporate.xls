      <Cell ss:StyleID="DataRowNumber"><Data ss:Type="Number">6900</Data></Cell>
    </Row>
<Row ss:Height="22">
      <Cell ss:StyleID="DataRowAltCenter"><Data ss:Type="Number">2</Data></Cell>
      <Cell ss:StyleID="DataRowAltCenter"><Data ss:Type="String">CRP-FLEET-02</Data></Cell>
      <Cell ss:StyleID="DataRowAlt"><Data ss:Type="String">منصة إدارة الحركة والمسارات سنوي مع لوحة تحكم ذكية</Data></Cell>
      <Cell ss:StyleID="DataRowAltCenter"><Data ss:Type="String">ترخيص</Data></Cell>
      <Cell ss:StyleID="DataRowAltNumber"><Data ss:Type="Number">1</Data></Cell>
      <Cell ss:StyleID="DataRowAltNumber"><Data ss:Type="Number">8900</Data></Cell>
