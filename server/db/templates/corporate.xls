    <Cell ss:StyleID="Header"><Data ss:Type="String">المجموع شامل الضريبة</Data></Cell>
   </Row>
   <Row ss:Height="22">
      <Cell ss:StyleID="DataRowCenter"><Data ss:Type="Number">1</Data></Cell>
      <Cell ss:StyleID="DataRowCenter"><Data ss:Type="String">CRP-FLEET-01</Data></Cell>
      <Cell ss:StyleID="DataRow"><Data ss:Type="String">تجهيزات سيارات أسطول وتتبع GPS الذكي مع حساسات الوزن</Data></Cell>
