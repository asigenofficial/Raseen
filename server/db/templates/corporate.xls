    <Cell ss:Index="3" ss:StyleID="CardValue"><Data ss:Type="String">300991122300003</Data></Cell>
    <Cell ss:Index="7" ss:StyleID="CardLabel"><Data ss:Type="String">تاريخ الفاتورة:</Data></Cell>
    <Cell ss:Index="8" ss:StyleID="CardValue"><Data ss:Type="String">2026-09-14</Data></Cell>
   </Row>
   <Row ss:Height="22">
