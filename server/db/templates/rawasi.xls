   </Row>
   <Row ss:Height="14"/>
   <Row ss:Height="26">
    <Cell ss:StyleID="Header"><Data ss:Type="String">#</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">رقم الصنف</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">اسم الصنف والبيان</Data></Cell>
