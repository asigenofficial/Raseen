   <Column ss:Index="8" ss:Width="105"/>
   <Column ss:Index="9" ss:Width="90"/>
   <Column ss:Index="10" ss:Width="110"/>
   <Row ss:Height="28">
    <Cell ss:Index="2" ss:StyleID="CompanyTitle"><Data ss:Type="String">مؤسسة رواسي ينبع للاتصالات وتقنية المعلومات</Data></Cell>
    <Cell ss:Index="7" ss:StyleID="Default"><Data ss:Type="String">Rawasi Yanbu Telecom &amp; IT</Data></Cell>
   </Row>
   <Row ss:Height="20">
    <Cell ss:Index="2" ss:StyleID="Default"><Data ss:Type="String">السعودية - ينبع - طريق الملك عبدالعزيز - حي الزهور</Data></Cell>
    <Cell ss:Index="7" ss:StyleID="Default"><Data ss:Type="String">الرقم الضريبي: 302186150800003 | السجل: 7204077252</Data></Cell>
   </Row>
   <Row ss:Height="10"/>
   <Row ss:Height="24">
    <Cell ss:Index="5" ss:StyleID="Header"><Data ss:Type="String">فاتورة مبيعات أجهزة واتصالات ضريبية (TAX INVOICE)</Data></Cell>
   </Row>
   <Row ss:Height="10"/>
   <Row ss:Height="22">
