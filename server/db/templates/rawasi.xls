   </Row>
   <Row ss:Height="22">
      <Cell ss:StyleID="DataRowCenter"><Data ss:Type="Number">1</Data></Cell>
      <Cell ss:StyleID="DataRowCenter"><Data ss:Type="String">TEL-5G-01</Data></Cell>
      <Cell ss:StyleID="DataRow"><Data ss:Type="String">راوتر الجيل الخامس المنزلي فائق السرعة ZTE 5G مع شريحة بيانات</Data></Cell>
